+// Test-only RFC8449 hooks. This package never enters the Rust/Android product.
+package tls
+
+func (c *Conn) AeroBoxFixtureRecordSize(first, second int, expected uint16) {
+	c.aeroboxRslEnabled = true
+	c.aeroboxRslFirst, c.aeroboxRslSecond = first, second
+	c.aeroboxRslAdvertised = expected
+}
+func (c *Conn) AeroBoxFixtureRecordSizes() (records [3]int, maximum [3]int) {
+	return c.in.aeroboxReadRecords, c.in.aeroboxReadMaximum
+}
