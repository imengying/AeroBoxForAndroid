@@ -0,0 +1,50 @@
+// Test-only extension to the pinned uTLS server. Never part of AeroBox's
+// runtime or native libraries. The original TLS record/key-exchange machinery
+// is retained; this entry point initiates RFC 5746 renegotiation for a client.
+package tls
+
+import (
+	"context"
+	"errors"
+)
+
+func (c *Conn) AeroBoxFixtureMode(mode string) { c.aeroboxRenegotiationMode = mode }
+func (c *Conn) AeroBoxFixtureHellos() [][]byte { return c.aeroboxClientHellos }
+func (c *Conn) AeroBoxFixtureTrace() []string  { return append([]string(nil), c.aeroboxFixtureTrace...) }
+func (c *Conn) AeroBoxFixtureHandshakes() int  { return c.handshakes }
+
+func (c *Conn) AeroBoxFixtureRenegotiate(config *Config, mode string) error {
+	c.handshakeMutex.Lock()
+	defer c.handshakeMutex.Unlock()
+	c.in.Lock()
+	defer c.in.Unlock()
+	if c.isClient || (c.vers < VersionTLS10 || c.vers > VersionTLS12) || !c.isHandshakeComplete.Load() || c.handshakeErr != nil {
+		return errors.New("fixture requires an established TLS1.0/1.1/1.2 server connection")
+	}
+	c.aeroboxFixtureTrace = append(c.aeroboxFixtureTrace, "hello-request")
+	c.out.Lock()
+	_, err := c.writeRecordLocked(recordTypeHandshake, []byte{0, 0, 0, 0})
+	c.out.Unlock()
+	if err != nil {
+		return err
+	}
+	if config != nil {
+		c.config = config.Clone()
+	}
+	c.aeroboxRenegotiationMode = mode
+	c.didResume = false
+	c.isHandshakeComplete.Store(false)
+	c.handshakeErr = c.serverHandshake(context.Background())
+	if c.handshakeErr == nil {
+		c.handshakes++
+	} else {
+		_, _ = c.flush()
+	}
+	return c.handshakeErr
+}
+
+// Test-only comparison of the independent TLS 1.0/1.1/1.2 key schedule across epochs.
+// The public Go API intentionally disallows exporters with renegotiation.
+func (c *Conn) AeroBoxFixtureExportKeyingMaterial() ([]byte, error) {
+	return c.ekm("aerobox-renegotiation", nil, 32)
+}
